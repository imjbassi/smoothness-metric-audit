{
    "algo_name": "diffusion_policy",
    "experiment": {
        "name": "random_s3",
        "validate": false,
        "logging": {
            "terminal_output_to_txt": true,
            "log_tb": true,
            "log_wandb": false
        },
        "save": {
            "enabled": true,
            "every_n_epochs": 100,
            "on_best_rollout_success_rate": true
        },
        "epoch_every_n_steps": 500,
        "rollout": {
            "enabled": true,
            "n": 50,
            "horizon": 400,
            "rate": 150,
            "warmstart": 0,
            "terminate_on_success": true
        },
        "render_video": false
    },
    "train": {
        "data": [
            {
                "path": "datasets/can/mg/low_dim_sparse_v141.hdf5"
            }
        ],
        "output_dir": "/home/jaive/robomimic/results_train_dp",
        "num_data_workers": 2,
        "hdf5_cache_mode": "all",
        "hdf5_use_swmr": true,
        "hdf5_filter_key": "random_top50",
        "seq_length": 16,
        "frame_stack": 2,
        "pad_seq_length": true,
        "pad_frame_stack": true,
        "dataset_keys": [
            "actions",
            "rewards",
            "dones"
        ],
        "cuda": true,
        "batch_size": 256,
        "num_epochs": 600,
        "seed": 3
    },
    "algo": {
        "optim_params": {
            "policy": {
                "optimizer_type": "adamw",
                "learning_rate": {
                    "initial": 0.0001,
                    "decay_factor": 0.1,
                    "epoch_schedule": [],
                    "scheduler_type": "multistep"
                },
                "regularization": {
                    "L2": 1e-06
                }
            }
        },
        "horizon": {
            "observation_horizon": 2,
            "action_horizon": 8,
            "prediction_horizon": 16
        },
        "unet": {
            "enabled": true,
            "diffusion_step_embed_dim": 256,
            "down_dims": [
                256,
                512,
                1024
            ],
            "kernel_size": 5,
            "n_groups": 8
        },
        "ema": {
            "enabled": true,
            "power": 0.75
        },
        "ddpm": {
            "enabled": false,
            "num_train_timesteps": 100,
            "num_inference_timesteps": 100,
            "beta_schedule": "squaredcos_cap_v2",
            "clip_sample": true,
            "prediction_type": "epsilon"
        },
        "ddim": {
            "enabled": true,
            "num_train_timesteps": 100,
            "num_inference_timesteps": 10,
            "beta_schedule": "squaredcos_cap_v2",
            "clip_sample": true,
            "set_alpha_to_one": true,
            "steps_offset": 0,
            "prediction_type": "epsilon"
        }
    },
    "observation": {
        "modalities": {
            "obs": {
                "low_dim": [
                    "robot0_eef_pos",
                    "robot0_eef_quat",
                    "robot0_gripper_qpos",
                    "object"
                ]
            }
        }
    }
}